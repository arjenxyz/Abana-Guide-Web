GROQ_API_KEY=your_groq_api_key_here
# Free tier — no credit card. Get key at https://console.groq.com
# Best quality for tourism chat:
GROQ_MODEL=llama-3.3-70b-versatile
# Cheapest / highest free daily limits: llama-3.1-8b-instant
# Optional fallback list:
# GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant,openai/gpt-oss-20b
CHAT_RATE_LIMIT_PER_MINUTE=20
CHAT_RATE_LIMIT_PER_DAY=200
CHAT_DAILY_BUDGET_USD=3
GROQ_INPUT_COST_PER_1M=0.05
GROQ_OUTPUT_COST_PER_1M=0.08
