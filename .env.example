XAI_API_KEY=your_xai_api_key_here
# Primary model (cheapest default to preserve free credits)
XAI_MODEL=grok-build-0.1
# Optional comma-separated override, e.g. grok-build-0.1,grok-4.3,grok-4.5
# XAI_MODELS=grok-build-0.1,grok-4.20-0309-non-reasoning,grok-4.3,grok-4.5
CHAT_RATE_LIMIT_PER_MINUTE=20
CHAT_RATE_LIMIT_PER_DAY=200
CHAT_DAILY_BUDGET_USD=3
XAI_INPUT_COST_PER_1M=1.25
XAI_OUTPUT_COST_PER_1M=2.50
